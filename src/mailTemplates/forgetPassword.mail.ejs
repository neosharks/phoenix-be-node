<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password</title>
  <style>
      body {
        font-family: "Arial", sans-serif;
        background-color: #f8f8f8;
        margin: 0;
        padding: 0;
        text-align: center;
      }

      .container {
        max-width: 600px;
        margin: 18px auto;
        padding: 18px;
        background-color: #fff;
        border: 1px solid #ddd;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
      }

      .header, .footer {
        background:rgb(174, 107, 237);
        color: white;
        padding: 12px;
        text-align: center;
        border-radius: 10px 10px 0 0;
      }

      .footer {
        border-radius: 0 0 10px 10px;
        margin-top: 20px;
      }
      
      .footer p {
        color: black;
      }

      img {
        max-width: 150px;
        margin: 20px 0;
        border-radius: 8px;
      }

      h2 {
        font-size: 1.5rem;
        color: #333;
        margin: 20px 0;
      }

      p {
       font-size: 1rem;
    	  font-family: __Public_Sans_d7c01c, __Public_Sans_Fallback_d7c01c, Helvetica, Arial, sans-serif;
        font-weight: 400;
        line-height: 1.8;
        color: #555;
        margin: 15px 0;
      }

      .divider {
        height: 1px;
        background-color: #ddd;
        margin: 20px 0;
      }
      .otp-container {
        background-color: #e4f1fe;
        padding: 10px;
        border-radius: 6px;
        display: inline-block;
      }
      .otp {
        font-size: 1.5rem;
        font-weight: bold;
        color: rgb(118, 53, 220);
      }
      @media (max-width: 600px) {
        .container {
          padding: 10px;
        }

        img {
          max-width: 150px;
        }

        h2 {
          font-size: 26px;
        }

        p {
          font-size: 18px;
        }
      }
    </style>
</head>

<body>
  <div class="container">
  
<img src="./logo.png" alt="Company Logo" />
    <h2>Forgot Password</h2>

    <p>
      Hello <%= name %>, You are receiving this email because we received a password reset request
      for your account.
    </p>

    <p>
      Please enter the following code:
      <span class="otp-container"><span class="otp"><%= code %></span></span>
    </p>

    <p>You can contact us at contact@qalakar.in</p>
     <p>
        Best regards,
        <br />
        qalakar.com
      </p>

  <div class="footer">
        <p>© 2024 Qalakar. All rights reserved.</p>
      </div>
    </div>
  </div>
</body>
</html>
