generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String?   @unique
  username     String    @unique
  phoneNumber  String?   @unique
  countryCode  String    @default("+91")
  profileImage String?
  coverImage   String?
  gender       GENDER?
  role         ROLE[]    @default([PATRON])
  bio          String?
  country      COUNTRY   @default(INDIA)
  dob          DateTime?
  industry     INDUSTRY?

  password String?

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  packages Package[]

  googleAuthId   String? @unique
  facebookAuthId String? @unique

  verificationCode          Int?
  verificationCodeTimestamp DateTime?                 @default(now())
  verificationCodeSource    VERIFICATION_CODE_SOURCE?
  verificationCodeType      VERIFICATION_CODE_TYPE?   @default(LOGIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Message          Message[]
  participantOne   Chat[]          @relation("participantOne")
  participantTwo   Chat[]          @relation("participantTwo")
  aboutUser        Notification[]  @relation("aboutUser")
  notificationUser Notification[]  @relation("notificationUser")
  Polls            Polls[]
  Journey          Journey[]
  creatorId        PatronCreator[] @relation("creatorId")
  patronId         PatronCreator[] @relation("patronId")

  @@index([email, username, phoneNumber])
}

model Tier {
  id          String    @id @default(cuid())
  tierType    TIER_TYPE @default(GENERAL_SUPPORT)
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Package     Package[]
}

model Package {
  id            String          @id @default(cuid())
  tier          Tier[]
  name          String
  image         String
  price         Int
  description   String
  User          User            @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PatronCreator PatronCreator[]
}

model Message {
  id          String       @id @default(cuid())
  chat        Chat         @relation(fields: [chatId], references: [id])
  sender      User         @relation(fields: [senderId], references: [id])
  message     String
  senderId    String
  contentType MESSAGE_TYPE @default(TEXT)
  chatId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([chatId])
}

model Chat {
  id               String    @id @default(cuid())
  participantOne   User      @relation("participantOne", fields: [participantOneId], references: [id])
  participantTwo   User      @relation("participantTwo", fields: [participantTwoId], references: [id])
  participantOneId String
  participantTwoId String
  type             CHAT_TYPE @default(ONE_TO_ONE)
  Message          Message[]
  unreadCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Notification {
  id                 String       @id @default(cuid())
  aboutUser          User?        @relation("aboutUser", fields: [aboutUserId], references: [id])
  notificationUser   User         @relation("notificationUser", fields: [notificationUserId], references: [id])
  aboutUserId        String
  notificationUserId String
  message            String
  read               Boolean
  link               String?
  type               NOTIFICATION
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String

  @@index([userId])
}

model Polls {
  id              String   @id @default(cuid())
  creatorId       User     @relation(fields: [userId], references: [id])
  options         String[]
  selectedOptions Json
  userId          String
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Journey {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id])
  userId    String
  path      String
  method    REQUEST_METHOD @default(GET)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PatronCreator {
  id        String   @id @default(cuid())
  patron    User     @relation("patronId", fields: [patronId], references: [id])
  patronId  String
  creator   User     @relation("creatorId", fields: [creatorId], references: [id])
  creatorId String
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String
  expiry    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TIER_TYPE {
  GENERAL_SUPPORT
  AD_FREE_CONTENT
  BEHIND_THE_SCENES
  DIGITAL_DOWNLOADS
}

enum ROLE {
  PATRON
  CREATOR
  ADMIN
}

enum COUNTRY {
  INDIA
}

enum INDUSTRY {
  MUSIC
  GAMING
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum NOTIFICATION {
  NEW_POST
  MESSAGE
  POLL
}

enum MESSAGE_TYPE {
  TEXT
  IMAGE
  AUDIO
}

enum CHAT_TYPE {
  ONE_TO_ONE
}

enum REQUEST_METHOD {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum VERIFICATION_CODE_SOURCE {
  WHATSAPP
  SMS
  EMAIL
}

enum VERIFICATION_CODE_TYPE {
  LOGIN
}
