generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  username     String    @unique
  phone        Int?
  password     String
  profileImage String?
  coverImage   String?
  gender       GENDER?
  role         ROLE[]    @default([PATRON])
  bio          String?
  country      COUNTRY   @default(INDIA)
  dob          DateTime?
  industry     INDUSTRY?
  packages     Package[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Message          Message[]
  participantOne   Chat[]         @relation("participantOne")
  participantTwo   Chat[]         @relation("participantTwo")
  aboutUser        Notification[] @relation("aboutUser")
  notificationUser Notification[] @relation("notificationUser")

  @@index([email, username])
}

model Tier {
  id          String    @id @default(uuid())
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Package     Package[]
}

model Package {
  id        String   @id @default(uuid())
  tiers     Tier     @relation(fields: [tierId], references: [id])
  name      String
  price     Int
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tierId    String   @unique
}

model Message {
  id          String       @id @default(uuid())
  chat        Chat         @relation(fields: [chatId], references: [id])
  sender      User         @relation(fields: [senderId], references: [id])
  message     String
  senderId    String
  contentType MESSAGE_TYPE @default(TEXT)
  chatId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([chatId])
}

model Chat {
  id               String    @id @default(uuid())
  participantOne   User      @relation("participantOne", fields: [participantOneId], references: [id])
  participantTwo   User      @relation("participantTwo", fields: [participantTwoId], references: [id])
  participantOneId String
  participantTwoId String
  type             CHAT_TYPE @default(ONE_TO_ONE)
  Message          Message[]
  unreadCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Notification {
  id                 String       @id @default(uuid())
  aboutUser          User?        @relation("aboutUser", fields: [aboutUserId], references: [id])
  notificationUser   User         @relation("notificationUser", fields: [notificationUserId], references: [id])
  aboutUserId        String
  notificationUserId String
  message            String
  read               Boolean
  link               String?
  type               NOTIFICATION
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String
}

enum ROLE {
  PATRON
  CREATOR
  ADMIN
}

enum COUNTRY {
  INDIA
}

enum INDUSTRY {
  MUSIC
  GAMING
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum NOTIFICATION {
  NEW_POST
  MESSAGE
  POLL
}

enum MESSAGE_TYPE {
  TEXT
  IMAGE
  AUDIO
}

enum CHAT_TYPE {
  ONE_TO_ONE
}
