generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  username     String    @unique
  password     String
  profileImage String?
  coverImage   String?
  gender       GENDER?
  role         ROLE[]    @default([PATRON])
  bio          String?
  country      COUNTRY   @default(INDIA)
  dob          DateTime?
  industry     INDUSTRY?
  packages     Package[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Message        Message[]
  participantOne Chat[]    @relation("participantOne")
  participantTwo Chat[]    @relation("participantTwo")
}

model Tier {
  id          String    @id @default(uuid())
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Package     Package[]
}

model Package {
  id        String   @id @default(uuid())
  tiers     Tier     @relation(fields: [tierId], references: [id])
  name      String
  price     Int
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tierId    String   @unique
}

model Message {
  id        String   @id @default(uuid())
  chat      Chat     @relation(fields: [chatId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  senderId  String
  chatId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chat {
  id               String    @id @default(uuid())
  participantOne   User      @relation("participantOne", fields: [participantOneId], references: [id])
  participantTwo   User      @relation("participantTwo", fields: [participantTwoId], references: [id])
  participantOneId String
  participantTwoId String
  Message          Message[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum ROLE {
  PATRON
  CREATOR
  ADMIN
}

enum COUNTRY {
  INDIA
}

enum INDUSTRY {
  MUSIC
  GAMING
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}
