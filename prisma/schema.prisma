generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           Int       @id @default(autoincrement())
  firstName                    String?
  lastName                     String?
  email                        String?   @unique
  username                     String    @unique
  phoneNumber                  String?   @unique
  whatsappNumber               String?
  countryCode                  String    @default("+91")
  profileImage                 String?
  coverImage                   String?
  language                     String?
  theme                        String?
  isCreator                    Boolean   @default(false)
  gender                       GENDER?
  role                         ROLE[]    @default([PATRON])
  bio                          String?
  country                      COUNTRY   @default(INDIA)
  dob                          DateTime?
  industry                     INDUSTRY?
  onBoardingComplete           Boolean   @default(false)
  onBoardingCompletePercentage Int       @default(0)
  pageName                     String?
  youtubeHandle                String?
  facebookHandle               String?
  twitterHandle                String?
  instagramHandle              String?

  creatorApprovalStatus  CREATOR_APPROVAL_STATUS @default(UNINITIATED)
  creatorChangeTimeStamp DateTime?

  status USER_STATUS @default(ACTIVE)

  password String?

  referralUserId    Int?
  referralTimeStamp DateTime?
  referralDevice    String?

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  packages Package[]

  googleAuthId   String? @unique
  facebookAuthId String? @unique

  verificationCode          Int?
  verificationCodeTimestamp DateTime?                 @default(now())
  verificationCodeAttempts  Int                       @default(0)
  verificationCodeSource    VERIFICATION_CODE_SOURCE?

  online       Boolean   @default(false)
  fcmToken     String?
  lastSeen     DateTime?
  eulaAccepted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Message              Message[]
  participantOne       Chat[]               @relation("participantOne")
  participantTwo       Chat[]               @relation("participantTwo")
  aboutUser            Notification[]       @relation("aboutUser")
  notifiedUser         Notification[]       @relation("notifiedUser")
  Poll                 Poll[]
  creatorId            PatronCreator[]      @relation("creatorId")
  patronId             PatronCreator[]      @relation("patronId")
  Comment              PostComment[]
  UserPostAuthor       UserPost[]           @relation("userPostAuthor")
  likedByUser          UserPost[]           @relation("likedByUser")
  receivedTransactions WalletTransactions[] @relation("ReceiverTransactions")
  sentTransactions     WalletTransactions[] @relation("SenderTransactions")
  Payment              Payment[]
  ClickStream          ClickStream[]
  AllLinks             AllLinks[]
  ClassParticipants    ClassParticipants[]
  ClassMessages        ClassMessage[]
  Class                Class[]
  Reporter             OffensiveReporting[] @relation("Reporter")
  Reportee             OffensiveReporting[] @relation("Reportee")
  ReportResolver       OffensiveReporting[] @relation("ReportResolver")
  CombinedCommunity    CombinedCommunity[]
  CommunityCreator     CommunityCreator[]

  @@index([email, username, phoneNumber])
}

model CombinedCommunity {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  tags        String[] @default([])
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById Int
  isActive    Boolean  @default(true)

  CommunityCreator CommunityCreator[]
  UserPost         UserPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityCreator {
  id               Int                      @id @default(autoincrement())
  user             User                     @relation(fields: [userId], references: [id])
  userId           Int
  community        CombinedCommunity        @relation(fields: [communityId], references: [id])
  communityId      Int
  status           COMMUNITY_CREATOR_STATUS @default(PENDING)
  statusUpdateDate DateTime?
  isActive         Boolean                  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tier {
  id          Int       @id @default(autoincrement())
  tierType    TIER_TYPE @default(GENERAL_SUPPORT)
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Package     Package[]
}

model Package {
  id            Int             @id @default(autoincrement())
  tier          Tier[]
  name          PACKAGE_NAMES   @default(SUPPORT)
  price         Int
  description   String
  creator       User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId     Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PatronCreator PatronCreator[]
  UserPost      UserPost?       @relation(fields: [userPostId], references: [id])
  userPostId    Int?
  Payment       Payment[]
}

model Message {
  id          Int          @id @default(autoincrement())
  chat        Chat         @relation(fields: [chatId], references: [id])
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message     String
  senderId    Int
  contentType MESSAGE_TYPE @default(TEXT)
  chatId      Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([chatId])
}

model Chat {
  id               Int               @id @default(autoincrement())
  participantOne   User              @relation("participantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User              @relation("participantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  participantOneId Int
  participantTwoId Int
  type             CONVERSATION_TYPE @default(ONE_TO_ONE)
  Message          Message[]
  unreadCount      Int               @default(0)
  pendingAllowed   Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Notification {
  id             Int          @id @default(autoincrement())
  aboutUser      User?        @relation("aboutUser", fields: [aboutUserId], references: [id], onDelete: Cascade)
  notifiedUser   User         @relation("notifiedUser", fields: [notifiedUserId], references: [id], onDelete: Cascade)
  aboutUserId    Int
  notifiedUserId Int
  message        String
  read           Boolean
  link           String?
  type           NOTIFICATION
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([aboutUserId, notifiedUserId])
}

model PatronCreator {
  id        Int                   @id @default(autoincrement())
  patron    User                  @relation("patronId", fields: [patronId], references: [id], onDelete: Cascade)
  patronId  Int
  creator   User                  @relation("creatorId", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId Int
  package   Package?              @relation(fields: [packageId], references: [id])
  packageId Int?
  type      SUBSCRIPTION_TYPE     @default(FREE)
  expiry    DateTime?
  status    PATRON_CREATOR_STATUS @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model UserPost {
  id                  Int                  @id @default(autoincrement())
  author              User                 @relation("userPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId            Int
  type                USER_POST_TYPE       @default(TEXT)
  comments            PostComment[]
  likedBy             User[]               @relation("likedByUser")
  image               String?
  title               String?
  description         String?
  videoUrl            String?
  document            String?
  visibility          VISIBILITY           @default(EVERYONE)
  packages            Package[]
  allowComments       Boolean              @default(true)
  poll                Poll?                @relation(fields: [pollId], references: [id])
  pollId              Int?
  class               Class?               @relation(fields: [classId], references: [id])
  classId             Int?
  combinedCommunity   CombinedCommunity?   @relation(fields: [combinedCommunityId], references: [id])
  combinedCommunityId Int?
  OffensiveReporting  OffensiveReporting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility, authorId])
}

model PostComment {
  id          Int      @id @default(autoincrement())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  description String
  post        UserPost @relation(fields: [userPostId], references: [id], onDelete: Cascade)
  userPostId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Poll {
  id              Int        @id @default(autoincrement())
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        Int
  options         Json[]
  selectedOptions Json[]
  image           String?
  title           String?
  description     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  UserPost        UserPost[]
}

model ClickStream {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?
  info      Json?
  type      String?
  url       String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                 Int                  @id @default(autoincrement())
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  orderId            String               @unique
  amount             Int                  @default(0)
  currency           CURRENCY             @default(INR)
  status             PAYMENT_STATUS       @default(CREATED)
  class              Class?               @relation(fields: [classId], references: [id])
  classId            Int?
  paymentFor         PAYMENT_FOR          @default(CLASS)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  WalletTransactions WalletTransactions[]
  Package            Package?             @relation(fields: [packageId], references: [id])
  packageId          Int?

  @@index([orderId])
}

model WalletTransactions {
  id         Int           @id @default(autoincrement())
  receiver   User          @relation(name: "ReceiverTransactions", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId Int
  sender     User?         @relation(name: "SenderTransactions", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   Int?
  source     WALLET_SOURCE @default(PURCHASE)
  amount     Int
  currency   CURRENCY      @default(INR)
  cashFlow   CASHFLOW
  Payment    Payment?      @relation(fields: [paymentId], references: [id])
  paymentId  Int?
  state      WALLET_STATE
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model AllLinks {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  url       String
  platform  String?
  highlight Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Class {
  id                Int                 @id @default(autoincrement())
  creator           User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId         Int
  name              String
  isPaid            Boolean             @default(false)
  type              String?
  price             Int?
  isActive          Boolean             @default(true)
  paymentFrequency  PAYMENT_FREQUENCY?  @default(ONE_TIME)
  ClassParticipants ClassParticipants[]
  ClassMessage      ClassMessage[]
  UserPost          UserPost[]
  Payment           Payment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ClassMessage {
  id               Int            @id @default(autoincrement())
  classId          Int
  userId           Int
  message          String?
  image            String?
  audio            String?
  video            String?
  document         String?
  repliedMessageId Int?
  reactions        Json?
  isPinned         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  class            Class          @relation(fields: [classId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  repliedMessage   ClassMessage?  @relation("MessageReplies", fields: [repliedMessageId], references: [id])
  replies          ClassMessage[] @relation("MessageReplies")
}

model ClassParticipants {
  id        Int      @id @default(autoincrement())
  class     Class    @relation(fields: [classId], references: [id])
  classId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, userId])
}

model ClassRequest {
  id        Int      @id @default(autoincrement())
  userId    Int
  creatorId Int
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, creatorId])
}

model OffensiveReporting {
  id               Int            @id @default(autoincrement())
  type             REPORTING_TYPE
  reportedByUser   User           @relation("Reporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)
  reportedByUserId Int
  reportedUser     User?          @relation("Reportee", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedUserId   Int?
  resolvedBy       User?          @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Cascade)
  resolvedById     Int?
  message          String?
  userPost         UserPost?      @relation(fields: [userPostId], references: [id])
  userPostId       Int?
  resolved         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum REPORTING_TYPE {
  USER
  POST
  MESSAGE
}

enum WALLET_STATE {
  PROCESSING
  DEBITED
  CREDITED
  FAILED
}

enum CASHFLOW {
  DEBIT
  CREDIT
}

enum PAYMENT_FOR {
  CLASS
  OTHERS
}

enum WALLET_SOURCE {
  REFERRAL
  PURCHASE
}

enum CURRENCY {
  INR
}

enum ROLE {
  PATRON
  CREATOR
  ADMIN
}

enum PACKAGE_NAMES {
  SUPPORT
  BRONZE
  SILVER
  GOLD
  PLATINUM
  RUBY
}

enum TIER_TYPE {
  GENERAL_SUPPORT
  EXCLUSIVE_POSTS
  BEHIND_THE_SCENES
  UNLIMITED_MESSAGE
  ONE_TIME_MESSAGE
  NAME_POST_DESCRIPTION
  NAME_POST_END
  EXCLUSIVE_POLLS
  MENTORSHIP
  COMMUNITY
}

enum COUNTRY {
  INDIA
  NEPAL
  SRI_LANKA
  BHUTAN
  PAKISTAN
}

enum INDUSTRY {
  BEAUTY_AND_MAKEUP
  MUSIC
  COMEDY
  PHOTOGRAPHY
  POETRY
  JOURNALISM
  STREAMING
  ESPORTS
  MODELING
  TECHNOLOGY_REVIEWS
  SOFTWARE_DEVELOPMENT
  FITNESS_TRAINING
  NUTRITION
  DIY_CRAFTS
  HOME_RENOVATION
  TRAVEL_BLOGGING
  ADVENTURE
  SCIENCE_COMMUNICATION
  ONLINE_EDUCATION
  LIFE_COACHING
  SOCIAL_ACTIVISM
  ANIMAL_WELFARE
  CULTURAL_INFLUENCE
  HANDMADE_CRAFTS
  CAR_ENTHUSIASTS
  COLLECTING
  HOBBYISTS
  ENTERTAINMENT_INDUSTRY
  VISUAL_ARTS
  WRITING_AND_PUBLISHING
  GAMING
  FASHION_AND_BEAUTY
  COOKING_AND_FOOD
  TECHNOLOGY_AND_GADGETS
  HEALTH_AND_FITNESS
  DIY_AND_HOME_IMPROVEMENT
  TRAVEL_AND_ADVENTURE
  SCIENCE_AND_EDUCATION
  PERSONAL_DEVELOPMENT_AND_MOTIVATION
  PARENTING_AND_FAMILY
  FINANCE_AND_INVESTMENT
  PETS_AND_ANIMALS
  LIFESTYLE_AND_CULTURE
  ARTISANS_AND_CRAFTSMEN
  AUTOMOTIVE_AND_DIY_MECHANICS
  NICHE_HOBBIES
}

enum PATRON_CREATOR_STATUS {
  ACTIVE
  EXPIRED
  PENDING
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum NOTIFICATION {
  NEW_POST
  MESSAGE
  POLL
  MENTIONED
  NEW_COMMENT
  NEW_LIKE
  CLASS
}

enum MESSAGE_TYPE {
  TEXT
  IMAGE
  AUDIO
}

enum CONVERSATION_TYPE {
  ONE_TO_ONE
}

enum VERIFICATION_CODE_SOURCE {
  WHATSAPP
  SMS
  EMAIL
}

enum USER_STATUS {
  ACTIVE
  INACTIVE
  DELETED
  BLOCKED
}

enum CREATOR_APPROVAL_STATUS {
  PENDING
  APPROVED
  DENIED
  UNINITIATED
}

enum VERIFICATION_CODE_TYPE {
  LOGIN
  FORGET_PASSWORD
}

enum USER_POST_TYPE {
  TEXT
  IMAGE
  POLL
  LINK
  VIDEO
  CLASS
  DOCUMENT
}

enum VISIBILITY {
  EVERYONE
  FREE_MEMBER
  PAID_MEMBER
}

enum SUBSCRIPTION_TYPE {
  FREE
  PAID
}

enum PAYMENT_STATUS {
  CREATED
  PAID
  FAILED
  PENDING
}

enum PAYMENT_FREQUENCY {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum COMMUNITY_CREATOR_STATUS {
  PENDING
  ACCEPTED
  DENIED
}
