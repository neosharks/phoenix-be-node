generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?   @unique
  username        String    @unique
  phoneNumber     String?   @unique
  countryCode     String    @default("+91")
  profileImage    String?
  coverImage      String?
  isCreator       Boolean   @default(false)
  gender          GENDER?
  role            ROLE[]    @default([PATRON])
  bio             String?
  country         COUNTRY   @default(INDIA)
  dob             DateTime?
  industry        INDUSTRY?
  pageName        String?
  youtubeHandle   String?
  facebookHandle  String?
  twitterHandle   String?
  instagramHandle String?

  password String?

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  packages Package[]

  googleAuthId   String? @unique
  facebookAuthId String? @unique

  verificationCode          Int?
  verificationCodeTimestamp DateTime?                 @default(now())
  verificationCodeSource    VERIFICATION_CODE_SOURCE?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Message        Message[]
  participantOne Chat[]          @relation("participantOne")
  participantTwo Chat[]          @relation("participantTwo")
  aboutUser      Notification[]  @relation("aboutUser")
  notifiedUser   Notification[]  @relation("notifiedUser")
  Poll           Poll[]
  creatorId      PatronCreator[] @relation("creatorId")
  patronId       PatronCreator[] @relation("patronId")
  Comment        PostComment[]
  UserPostAuthor UserPost[]      @relation("userPostAuthor")
  likedByUser    UserPost[]      @relation("likedByUser")

  @@index([email, username, phoneNumber])
}

model Tier {
  id          String    @id @default(cuid())
  tierType    TIER_TYPE @default(GENERAL_SUPPORT)
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Package     Package[]
}

model Package {
  id            String          @id @default(cuid())
  tier          Tier[]
  name          String
  image         String
  price         Int
  description   String
  User          User            @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PatronCreator PatronCreator[]
}

model Message {
  id          String       @id @default(cuid())
  chat        Chat         @relation(fields: [chatId], references: [id])
  sender      User         @relation(fields: [senderId], references: [id])
  message     String
  senderId    String
  contentType MESSAGE_TYPE @default(TEXT)
  chatId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([chatId])
}

model Chat {
  id               String            @id @default(cuid())
  participantOne   User              @relation("participantOne", fields: [participantOneId], references: [id])
  participantTwo   User              @relation("participantTwo", fields: [participantTwoId], references: [id])
  participantOneId String
  participantTwoId String
  type             CONVERSATION_TYPE @default(ONE_TO_ONE)
  Message          Message[]
  unreadCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Notification {
  id             String       @id @default(cuid())
  aboutUser      User?        @relation("aboutUser", fields: [aboutUserId], references: [id])
  notifiedUser   User         @relation("notifiedUser", fields: [notifiedUserId], references: [id])
  aboutUserId    String
  notifiedUserId String
  message        String
  read           Boolean
  link           String?
  type           NOTIFICATION
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([aboutUserId, notifiedUserId])
}

model PatronCreator {
  id        String   @id @default(cuid())
  patron    User     @relation("patronId", fields: [patronId], references: [id])
  patronId  String
  creator   User     @relation("creatorId", fields: [creatorId], references: [id])
  creatorId String
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String
  expiry    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPost {
  id        String         @id @default(cuid())
  author    User           @relation("userPostAuthor", fields: [authorId], references: [id])
  authorId  String
  isPrivate Boolean        @default(false)
  type      USER_POST_TYPE @default(TEXT)
  comments  PostComment[]
  likedBy   User[]         @relation("likedByUser")
  body      String
  image     String?
  title     String?
  poll      Poll?          @relation(fields: [pollId], references: [id])
  pollId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PostComment {
  id         String   @id @default(cuid())
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  post       UserPost @relation(fields: [userPostId], references: [id])
  userPostId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Poll {
  id              String     @id @default(cuid())
  creatorId       User       @relation(fields: [userId], references: [id])
  options         String[]
  selectedOptions Json
  userId          String
  image           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  UserPost        UserPost[]
}

enum ROLE {
  PATRON
  CREATOR
  ADMIN
}

enum TIER_TYPE {
  GENERAL_SUPPORT
  BEHIND_THE_SCENES
  DIGITAL_DOWNLOADS
  ONE_TIME_MESSAGE
  UNLIMITED_MESSAGE
  EARLY_TICKETS
}

enum COUNTRY {
  INDIA
  NEPAL
  SRI_LANKA
  BHUTAN
  PAKISTAN
}

enum INDUSTRY {
  BEAUTY_AND_MAKEUP
  MUSIC
  COMEDY
  PHOTOGRAPHY
  POETRY
  JOURNALISM
  STREAMING
  ESPORTS
  MODELING
  TECHNOLOGY_REVIEWS
  SOFTWARE_DEVELOPMENT
  FITNESS_TRAINING
  NUTRITION
  DIY_CRAFTS
  HOME_RENOVATION
  TRAVEL_BLOGGING
  ADVENTURE
  SCIENCE_COMMUNICATION
  ONLINE_EDUCATION
  LIFE_COACHING
  SOCIAL_ACTIVISM
  ANIMAL_WELFARE
  CULTURAL_INFLUENCE
  HANDMADE_CRAFTS
  CAR_ENTHUSIASTS
  COLLECTING
  HOBBYISTS
  ENTERTAINMENT_INDUSTRY
  VISUAL_ARTS
  WRITING_AND_PUBLISHING
  GAMING
  FASHION_AND_BEAUTY
  COOKING_AND_FOOD
  TECHNOLOGY_AND_GADGETS
  HEALTH_AND_FITNESS
  DIY_AND_HOME_IMPROVEMENT
  TRAVEL_AND_ADVENTURE
  SCIENCE_AND_EDUCATION
  PERSONAL_DEVELOPMENT_AND_MOTIVATION
  PARENTING_AND_FAMILY
  FINANCE_AND_INVESTMENT
  PETS_AND_ANIMALS
  LIFESTYLE_AND_CULTURE
  ARTISANS_AND_CRAFTSMEN
  AUTOMOTIVE_AND_DIY_MECHANICS
  NICHE_HOBBIES
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum NOTIFICATION {
  NEW_POST
  MESSAGE
  POLL
  MENTIONED
  NEW_COMMENT
}

enum MESSAGE_TYPE {
  TEXT
  IMAGE
  AUDIO
}

enum CONVERSATION_TYPE {
  ONE_TO_ONE
}

enum VERIFICATION_CODE_SOURCE {
  WHATSAPP
  SMS
  EMAIL
}

enum VERIFICATION_CODE_TYPE {
  LOGIN
  FORGET_PASSWORD
}

enum USER_POST_TYPE {
  TEXT
  IMAGE
  POLL
  LINK
}
